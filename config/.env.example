# Пример переменных окружения для Yandex.Direct агента

# OAuth credentials (из developer.tech.yandex.ru)
YANDEX_DIRECT_CLIENT_ID=your_client_id_here
YANDEX_DIRECT_CLIENT_SECRET=your_client_secret_here

# Access Token (получается через OAuth)
YANDEX_DIRECT_ACCESS_TOKEN=your_access_token_here

# Refresh Token (для обновления access_token)
YANDEX_DIRECT_REFRESH_TOKEN=your_refresh_token_here

# Дополнительные настройки
# YANDEX_DIRECT_SANDBOX=true  # Использовать песочницу (для тестирования)
# YANDEX_DIRECT_LOCALE=ru      # Язык ответов API